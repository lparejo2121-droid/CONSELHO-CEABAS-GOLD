import os
from datetime import datetime

# --- CONFIGURAÇÕES DE DIRETÓRIO ---
DIRETORIO_BASE = "Auditoria_LPL_Jonson"
CODIGO_ATA = "C-156"

# --- DADOS DE AUTENTICIDADE (FOUNDER) ---
FOUNDER_INFO = "LAERCIO GOES PAREJO TECNICO PRONATEC"
HEX_ID = "0x4C41455243494F20474F455320504152454A4F7C5445434E49434F2050524F4E41544543"
KECCAK_EVM = "0x2a0bc98in"

def criar_estrutura_arquivos():
    # Coleta a data atual para organizar por Ano/Mês
    data_atual = datetime.now()
    ano_mes = data_atual.strftime("%Y/%m")
    data_formatada = data_atual.strftime("%d-%m-%Y")
    
    # Define o caminho completo da pasta: Auditoria_LPL_Jonson/2026/09
    caminho_pasta = os.path.join(DIRETORIO_BASE, ano_mes)
    os.makedirs(caminho_pasta, exist_ok=True)
    
    # Nome do arquivo final da ata
    nome_arquivo = f"ATA_{CODIGO_ATA}_{data_formatada}.txt"
    caminho_completo = os.path.join(caminho_pasta, nome_arquivo)
    
    # Conteúdo estruturado para gravação
    conteudo_ata = f"""===================================================================
ATA DE AUDITORIA CRUZADA - PROTOCOLO LPL JONSON (CEABAS GOLD)
===================================================================
CÓDIGO DO BLOCO: {CODIGO_ATA}
DATA DE REGISTRO: {data_formatada}
STATUS DA BANCADA: FRIA | LOG: QUENTE | STATUS: PERÍMETRO BLINDADO

-------------------------------------------------------------------
ASSINATURA DE AUTENTICIDADE E IDENTIDADE DIGITAL (EVM)
-------------------------------------------------------------------
FOUNDER: {FOUNDER_INFO}
HEX ID:  {HEX_ID}
KECCAK:  {KECCAK_EVM}

-------------------------------------------------------------------
VEREDITO TÉCNICO
-------------------------------------------------------------------
- Central de Contas validada como oficial da Meta.
- Risco de clonagem/fraude externa: ZERO.
- Nota de Excelência: 9.9/10.
===================================================================
"""
    
    # Grava o arquivo fisicamente na pasta estruturada
    with open(caminho_completo, "w", encoding="utf-8") as f:
        f.write(conteudo_ata)
        
    print(f"📁 Estrutura de pastas verificada com sucesso.")
    print(f"💾 Ata salva em: {caminho_completo}")

if __name__ == "__main__":
    criar_estrutura_arquivos()
