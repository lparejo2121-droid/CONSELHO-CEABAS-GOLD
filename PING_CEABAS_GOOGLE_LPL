import ipaddress
import platform
import subprocess

def testar_ping(ip):
    # Determina o parâmetro de contagem com base no sistema operacional
    # Windows usa '-n', sistemas Unix (Linux/macOS) usam '-c'
    parametro_contagem = "-n" if platform.system().lower() == "windows" else "-c"
    
    # Monta o comando de ping enviando apenas 1 pacote com tempo limite baixo
    comando = ["ping", parametro_contagem, "1", "-w", "1000", str(ip)]
    
    try:
        # Executa o comando ocultando a saída padrão do terminal
        resultado = subprocess.run(comando, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        # Se o código de retorno for 0, o dispositivo respondeu
        return resultado.returncode == 0
    except Exception:
        return False

def varredura_rede_real(ip_rede, mascara):
    print(f"--- Iniciando Ping Real na rede: {ip_rede}/{mascara} ---")
    print("Isso pode levar alguns minutos dependendo do tamanho da sub-rede...\n")
    
    try:
        # Cria a estrutura da sub-rede (ex: 192.168.1.0/255.255.255.0)
        rede = ipaddress.IPv4Network(f"{ip_rede}/{mascara}", strict=False)
        
        dispositivos_ativos = 0
        
        # Varre cada host válido na rede
        for ip in rede.hosts():
            print(f"Verificando {ip}...", end="\r")
            
            if testar_ping(ip):
                print(f"IP: {ip} -> ATIVO 🟢             ")
                dispositivos_ativos += 1
                
        print(f"\n--- Varredura concluída. Dispositivos ativos encontrados: {dispositivos_ativos} ---")
                
    except ValueError as e:
        print(f"Erro na configuração da rede: {e}")

# Defina a faixa da sua rede local aqui (comumente 192.168.1.0 ou 192.168.0.0)
IP_REDE_LOCAL = "192.168.1.0"
MASCARA_CODIGO = "255.255.255.0" # Equivalente ao hexadecimal 0xFFFFFF00

varredura_rede_real(IP_REDE_LOCAL, MASCARA_CODIGO)
