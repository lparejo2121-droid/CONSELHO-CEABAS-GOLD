import os
import random
import time
from datetime import datetime

# --- CONFIGURAÇÕES DE INFRAESTRUTURA (C-160) ---
DIRETORIO_BASE = "Auditoria_LPL_Jonson"
CODIGO_BLOCO = "C-160"
FAIXA_BLOCOS = "1120_a_1160"
CREA_SP = "5070081687"

# --- PARÂMETROS DO SWITCH TSN (MEMORIAL v47.5 ULTRA) ---
DRIFT_LIMITE_PS = 50.0  # Teto máximo permitido (+- 50ps)
LATENCIA_ALVO_NS = 0.8  # Limite nominal simétrico (<= 0.8ns)

def inicializar_estrutura_c160():
    """Cria a árvore de diretórios e o manifesto mestre do bloco."""
    pasta_protocolo = os.path.join(DIRETORIO_BASE, f"Protocolo_{CODIGO_BLOCO}")
    os.makedirs(pasta_protocolo, exist_ok=True)
    
    caminho_manifesto = os.path.join(pasta_protocolo, f"MANIFESTO_SHAX_{FAIXA_BLOCOS}.txt")
    
    manifesto_conteudo = f"""===================================================================
⚙️ MAPEAMENTO DE MALHA E REDES DETERMINÍSTICAS — PROTOCOLO {CODIGO_BLOCO}
===================================================================
FAIXA DE DIRETÓRIOS: BLOCOS {FAIXA_BLOCOS.upper()} // SHAX.7.7.7.[XX||]
STATUS OPERACIONAL: OPEN_PHASE // EM EXECUÇÃO DE TESTE
RESPONSÁVEL TÉCNICO: ENG. LAERCIO GOES PAREJO (CREA-SP {CREA_SP})
TIMESTAMP: {datetime.now().strftime('%d/%m/%Y - %H:%M:%S')}
-------------------------------------------------------------------
MÉTRICAS ATIVAS: TIMESTAMPS DE HARDWARE PTP IEEE 1588v2 INTEGRADOS
===================================================================
"""
    with open(caminho_manifesto, "w", encoding="utf-8") as f:
        f.write(manifesto_conteudo)
    return pasta_protocolo, caminho_manifesto

def rodar_simulacao_drift(ciclos=5):
    """Simula as janelas de transmissão verificando desvios em picossegundos."""
    print(f"📡 [TSN_CORE] Inicializando compensador de jitter para Switch TSN/SNP...")
    print(f"⏱️ [PARÂMETRO]: Monitoramento ativo de estabilização térmica de clock (Teto: ±{DRIFT_LIMITE_PS}ps).")
    print("-" * 90)
    print(f"{'CICLO':<8}{'TIMESTAMP PTP':<15}{'LATÊNCIA (ns)':<18}{'DRIFT DE CLOCK (ps)':<22}{'STATUS DE MALHA'}")
    print("-" * 90)
    
    erros = 0
    for i in range(1, ciclos + 1):
        time.sleep(0.3)  # Intervalo de amostragem física
        
        # Simula o comportamento do silício de alta precisão (OCXO/CSAC)
        latencia_atual = round(random.uniform(0.68, 0.79), 3)
        drift_atual = round(random.uniform(-48.5, 48.5), 1)
        ptp_time = datetime.now().strftime('%H:%M:%S.%f')[:-3]
        
        # Validação estrita contra os limites do Memorial v47.5 Ultra
        if latencia_atual <= LATENCIA_ALVO_NS and abs(drift_atual) <= DRIFT_LIMITE_PS:
            status = "🟢 ERRO_ZERO // STABLE"
        else:
            status = "🚨 JITTER_OVERLOAD"
            erros += 1
            
        print(f"{i:<8}{ptp_time:<15}{latencia_atual:<18}{drift_atual:<22}{status}")
        
    print("-" * 90)
    print(f"📊 [PROCESSO CONCLUÍDO]: {ciclos} pacotes de manos dados auditados. Taxa de erro: {(erros/ciclos)*100:.1f}%")

if __name__ == "__main__":
    # Executa a Opção 1: Inicialização lógica
    pasta, arquivo = inicializar_estrutura_c160()
    print(f"📁 Diretório do Protocolo criado em: '{pasta}'")
    print(f"💾 Manifesto gravado: '{os.path.basename(arquivo)}'")
    print("-" * 90)
    
    # Executa a Opção 2: Teste determinístico de clock
    rodar_simulacao_drift()
