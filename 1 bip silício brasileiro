import numpy as np
from scipy.io import wavfile
sr=96000
def gen(freq,ms):
  t=np.arange(int(sr*ms/1000))/sr
  d=np.sin(2*np.pi*freq*t)*0.6
  return (d*32767).astype(np.int16)
wavfile.write('SOM_DO_SILICIO.wav',sr,
  np.concatenate([gen(23841.86,250),np.zeros(int(sr*0.05)),gen(11920.93,250),np.zeros(int(sr*0.05)),gen(5960.46,500)])) 
